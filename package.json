{
  "name": "dsh-jianying-plugin",
  "version": "0.3.0",
  "description": "Teach DeepSeek Harness to safely edit Jianying Pro drafts with authorized subtitle, audio, transition, export, readback, and receipt workflows.",
  "author": "dsh-jianying-plugin contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CN-PA/dsh-jianying-plugin.git"
  },
  "homepage": "https://cn-pa.github.io/dsh-jianying-plugin/",
  "bugs": {
    "url": "https://github.com/CN-PA/dsh-jianying-plugin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/core.js",
    "./host": "./src/host.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "scripts",
    "skills",
    "assets",
    "site",
    "locale",
    "docs",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "jianying",
    "jianying-pro",
    "capcut",
    "draftediting",
    "ai-video-editing",
    "video-editing"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.7-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check src/index.js && node --check src/core.js && node --check src/host.js",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "test": "node --test tests/*.test.js",
    "smoke": "node scripts/smoke.mjs",
    "smoke:host": "node scripts/smoke-host.mjs",
    "pack:release": "node scripts/pack-release.mjs"
  }
}
